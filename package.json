{
  "name": "clown",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite --host",
    "typecheck": "tsc -b",
    "checkup": "npm run typecheck && vite build",
    "preview": "vite preview",
    "route-clear": "rm -rf ./src/app/routes/routeTree.gen.ts",
    "build": "npm run typecheck && npm run route-clear && vite build",
    "prettier": "npx prettier src --check",
    "lint": "eslint --fix ./src/**/*.{ts,tsx}",
    "prettier:fix": "npm run prettier -- --write"
  },
  "dependencies": {
    "@maskito/core": "^3.9.0",
    "@maskito/kit": "^3.9.0",
    "@maskito/react": "^3.9.0",
    "@tanstack/react-query": "^5.80.10",
    "@tanstack/react-router": "^1.121.24",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.58.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@tanstack/react-query-devtools": "^5.80.10",
    "@tanstack/react-router-devtools": "^1.134.9",
    "@tanstack/router-plugin": "^1.121.25",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^22.15.32",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "prettier": "3.5.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "unplugin-fonts": "^1.3.1",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0"
  },
  "engines": {
    "node": ">= 20",
    "npm": ">= 10"
  }
}
